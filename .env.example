# Copy this file to .env and fill in real values before running.
# Keep .env out of git and do not share it.

# Azure AI Speech
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=your_azure_region
AZURE_TTS_VOICE_RU=ru-RU-SvetlanaNeural
AZURE_TTS_VOICE_UZ=uz-UZ-MadinaNeural
AZURE_TTS_RATE=+25%

# Google Gemini / Vertex AI
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west1
VERTEX_AI_API_KEY=
GOOGLE_CREDENTIALS_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# Optional Telegram monitoring bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=

# Local database
POSTGRES_PASSWORD=ecovoice_password
DATABASE_URL=postgresql://ecovoice:ecovoice_password@postgres:5432/ecovoice_analytics

# Frontend
VITE_API_URL=/api
